# Modelo das variáveis de ambiente do PostRun · GeoHorun EM PRODUÇÃO
# (docker-compose.yml, plugado no Horun Core). Copie para `.env` e preencha —
# o `.env` nunca é versionado (.gitignore). Nenhum valor real entra aqui.

# Senha do PostgreSQL do módulo (o compose monta a URL do banco com ela).
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Rotas internas do RE7S. O token é um valor aleatório longo, IGUAL ao
# RE7S_GEOHORUN_TOKEN do .env do RE7S (gere um só e copie nos dois), ex.:
#   python -c "import secrets; print(secrets.token_hex(32))"
RE7S_INTERNAL_URL=http://re7s-backend:8000
RE7S_INTERNAL_TOKEN=

# Arquivos do Rock-Eval pelo Agente Horun do PC do equipamento (pastas "jobs"
# e "data" liberadas para este módulo no config.json do Agente).
POSTRUN_AGENT_MODE=true
POSTRUN_AGENT_TASK_TIMEOUT=30

# Envio dos resultados publicados ao Resultados — vazios = ficam na fila
# (reenviados sozinhos quando forem preenchidos).
POSTRUN_RESULTADOS_URL=
POSTRUN_RESULTADOS_TOKEN=

# Permissões por nível do Core (1 administrador … 5 IC): até que nível
# valida, despublica e é "admin" do GeoHorun (renomear/mover/trocar amostra).
POSTRUN_VALIDATE_MAX_LEVEL=4
POSTRUN_UNPUBLISH_MAX_LEVEL=2
GEOHORUN_ADMIN_MAX_LEVEL=2

# Backup do banco: pasta FORA do Docker, dias guardados, intervalo.
BACKUP_DIR=C:/HorunBackups/Horun-geohorun-backup
BACKUP_KEEP_DAYS=30
BACKUP_INTERVAL_HOURS=24
